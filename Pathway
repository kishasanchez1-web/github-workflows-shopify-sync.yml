name: Secure Shopify Real Estate Engine Sync

on:
  push:
    branches:
      - main
      - dev-realestate

jobs:
  deploy:
    name: Sync Real Estate Modules to Shopify
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout Source Code Data
        uses: actions/checkout@v4

      - name: Set Up Node.js Environment
        uses: actions/setup-node@v4
        with:
          node-node: '20'

      - name: Install Shopify CLI Tools
        run: npm install -g @shopify/cli

      - name: Validate & Push Theme Assets to Staging
        env:
          SHOPIFY_CLI_THEME_TOKEN: ${{ secrets.SHOPIFY_CLI_THEME_TOKEN }}
        run: |
          shopify theme push \
            --store="${{ secrets.SHOPIFY_STORE_DOMAIN }}" \
            --theme="${{ secrets.SHOPIFY_THEME_ID }}" \
            --unpublished \
            --node-id-dev
